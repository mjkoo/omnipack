[
  {
    "id": "com.game.cinderbox",
    "url": "https://github.com/Ekyso/Cinderbox",
    "name": "Cinderbox",
    "author": "Ekyso",
    "categories": [
      "PC Ports"
    ],
    "variants": [
      "single",
      "dual"
    ],
    "additionalSettings": {
      "includePrereleases": false,
      "versionDetection": true,
      "releaseTitleAsVersion": false,
      "trackOnly": false
    }
  },
  {
    "id": "com.aurora.store",
    "url": "https://gitlab.com/AuroraOSS/AuroraStore",
    "name": "Aurora Store",
    "author": "AuroraOSS",
    "categories": ["Utilities"],
    "variants": ["single", "dual"],
    "overrideSource": "GitLab",
    "additionalSettings": {
      "includePrereleases": false,
      "apkFilterRegEx": "^AuroraStore-[0-9]+(?:\\.[0-9]+)+\\.apk$",
      "autoApkFilterByArch": false,
      "versionDetection": true,
      "trackOnly": false
    }
  },
  {
    "id": "com.karin.idTech4Amm",
    "url": "https://github.com/glKarin/com.n0n3m4.diii4a",
    "name": "idTech4A++",
    "author": "glKarin",
    "categories": ["PC Ports"],
    "variants": ["single", "dual"],
    "additionalSettings": {
      "includePrereleases": false,
      "apkFilterRegEx": "^idTech4A\\+\\+_[^_]+\\.apk$",
      "autoApkFilterByArch": false,
      "versionDetection": false,
      "trackOnly": false,
      "about": "Requires user-supplied game data for supported id Tech games."
    }
  },
  {
    "id": "is.xyz.vcmi",
    "url": "https://github.com/vcmi/vcmi",
    "name": "VCMI",
    "author": "VCMI",
    "categories": ["PC Ports"],
    "variants": ["single", "dual"],
    "additionalSettings": {
      "includePrereleases": false,
      "apkFilterRegEx": "^VCMI-Android-.*\\.apk$",
      "autoApkFilterByArch": true,
      "versionDetection": true,
      "trackOnly": false,
      "about": "Requires user-supplied Heroes of Might and Magic III game data."
    }
  },
  {
    "id": "com.github.bvschaik.julius",
    "url": "https://github.com/bvschaik/julius",
    "name": "Julius",
    "author": "bvschaik",
    "categories": ["PC Ports"],
    "variants": ["single", "dual"],
    "additionalSettings": {
      "includePrereleases": false,
      "apkFilterRegEx": "^julius-.*-android\\.apk$",
      "autoApkFilterByArch": false,
      "versionDetection": true,
      "trackOnly": false,
      "about": "Requires user-supplied Caesar III game data."
    }
  },
  {
    "id": "su.xash.engine.test",
    "url": "https://github.com/FWGS/xash3d-fwgs",
    "name": "Xash3D FWGS",
    "author": "FWGS",
    "categories": ["PC Ports"],
    "variants": ["single", "dual"],
    "additionalSettings": {
      "includePrereleases": true,
      "fallbackToOlderReleases": false,
      "filterReleaseTitlesByRegEx": "^Xash3D FWGS Continuous master Build$",
      "verifyLatestTag": false,
      "useLatestAssetDateAsReleaseDate": true,
      "releaseDateAsVersion": true,
      "apkFilterRegEx": "^xash3d-fwgs-android\\.apk$",
      "autoApkFilterByArch": false,
      "versionDetection": false,
      "trackOnly": false,
      "about": "Rolling prerelease engine. Requires user-supplied Half-Life game data."
    }
  }
]
